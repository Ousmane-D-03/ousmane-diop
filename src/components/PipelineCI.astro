---
// Les étapes du pipeline GitHub Actions de Xëy Invest. Les trois contrôles
// de sécurité sont marqués ; le déploiement continu est encore à faire.
const etapes = [
	{ nom: 'Lint', etat: 'ok' },
	{ nom: 'Tests — pytest', etat: 'ok' },
	{ nom: 'Secrets — Gitleaks', etat: 'secu' },
	{ nom: 'SAST — Bandit', etat: 'secu' },
	{ nom: 'Images — Trivy', etat: 'secu' },
	{ nom: 'Build → Docker Hub', etat: 'ok' },
	{ nom: 'Déploiement continu', etat: 'en-cours' },
] as const;
---

<figure class="pipeline">
	<figcaption class="tete">
		<span>.github/workflows/ci.yml</span>
		<span class="voyant">● pipeline</span>
	</figcaption>
	<ol>
		{
			etapes.map(({ nom, etat }, i) => (
				<li class={etat}>
					<span class="rang">{String(i + 1).padStart(2, '0')}</span>
					<span class="nom">{nom}</span>
					{etat === 'ok' && (
						<span class="etat">
							<span aria-hidden="true">✓</span>
							<span class="lecteur">réussi</span>
						</span>
					)}
					{etat === 'secu' && <span class="etat">SÉCU</span>}
					{etat === 'en-cours' && <span class="etat">EN COURS</span>}
				</li>
			))
		}
	</ol>
</figure>

<style>
	.pipeline {
		margin: 0;
		background: var(--sombre);
		border-radius: 18px;
		padding: 32px;
		display: flex;
		flex-direction: column;
		gap: 22px;
		font-family: var(--font-mono);
		color: var(--sur-sombre);
	}

	.tete {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px;
		font-size: 13px;
		color: var(--sur-sombre-discret);
	}

	.voyant {
		color: var(--terminal-ok);
	}

	ol {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 10px;
		font-size: 14.5px;
	}

	li {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 12px 16px;
		border-radius: 10px;
		background: var(--sombre-releve);
	}

	.rang {
		width: 22px;
		color: var(--sur-sombre-discret);
	}

	.nom {
		flex: 1;
	}

	.ok .etat {
		color: var(--terminal-ok);
	}

	/* Contrôles de sécurité : liseré jaune à gauche. */
	.secu {
		box-shadow: inset 3px 0 0 var(--terminal-invite);
	}

	.secu .etat {
		color: var(--terminal-invite);
		font-size: 12px;
	}

	/* Étape à venir : cadre pointillé, sans fond. */
	.en-cours {
		background: none;
		border: 1.5px dashed #3a404a;
		color: var(--sur-sombre-discret);
	}

	.en-cours .etat {
		font-size: 12px;
	}

	/* Texte lu par les lecteurs d'écran à la place de la coche. */
	.lecteur {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (max-width: 600px) {
		.pipeline {
			padding: 20px;
		}

		li {
			padding: 12px;
			gap: 10px;
		}
	}
</style>

---
// Phrase clé sortie du corps de texte, en grande échelle. Elle figure déjà
// dans le texte : masquée aux lecteurs d'écran pour qu'ils ne la lisent pas
// deux fois. Reprendre la phrase mot pour mot, sans la réécrire.
---

<p class="exergue" aria-hidden="true"><slot /></p>

<style>
	/* Le contraste d'échelle fait tout le travail : pas de guillemets
	   décoratifs, pas de filet, pas de mouvement. Quelques lignes courtes,
	   équilibrées (text-wrap: balance). */
	.exergue {
		margin: 3.5rem 0;
		max-width: 22ch;
		font-family: var(--font-titres);
		font-weight: 500;
		font-size: clamp(1.7rem, 3.6vw, 2.6rem);
		line-height: 1.15;
		text-wrap: balance;
		color: var(--texte);
	}

	/* Bureau : l'exergue sort de la colonne du texte et part du bord de la
	   colonne des numéros, sur toute la largeur de la grille. */
	@media (min-width: 48rem) {
		.exergue {
			margin-left: calc(-1 * (var(--col-numero) + var(--gouttiere)));
			max-width: 24ch;
		}
	}
</style>

---
// Une fiche projet, depuis la collection de contenu. Le projet « vedette »
// occupe toute la largeur, son illustration à droite ; les autres sont des
// fiches plus compactes, l'illustration sous le texte.
import { render, type CollectionEntry } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import PipelineCI from './PipelineCI.astro';
import SchemaServerless from './SchemaServerless.astro';

interface Props {
	projet: CollectionEntry<'projets'>;
}

const { projet } = Astro.props;
const { titre, vedette, pastilles, stack, illustration, lien, image, captures } = projet.data;
const { Content } = await render(projet);

// Version pleine taille de chaque capture (WebP), pour le lien « voir en
// grand » : à la largeur de la fiche, le texte d'une capture se lit mal.
const enGrand = await Promise.all(captures.map((c) => getImage({ src: c.src, format: 'webp' })));
---

<article class:list={['projet', { vedette }]}>
	<div class="texte">
		{
			pastilles.length > 0 && (
				<ul class="statuts">
					{pastilles.map(({ texte, ton }) => (
						<li class={ton}>{texte}</li>
					))}
				</ul>
			)
		}
		<h2>{titre}</h2>
		<div class="corps"><Content /></div>
		{!vedette && illustration === 'serverless' && <SchemaServerless />}
		{
			image && (
				<figure class="image">
					{/* Hors du premier écran : chargement différé. À la largeur de la
					    fiche, le texte d'un diagramme est trop petit : lien vers l'image
					    en grand, en légende (un seul arrêt au clavier). */}
					<img
						src={image.src}
						alt={image.alt}
						width={image.largeur}
						height={image.hauteur}
						loading="lazy"
						decoding="async"
					/>
					<figcaption>
						<a href={image.src}>Voir le diagramme en grand</a>
					</figcaption>
				</figure>
			)
		}
		{
			stack.length > 0 && (
				<ul class="pastilles" aria-label="Technologies">
					{stack.map((outil) => (
						<li>{outil}</li>
					))}
				</ul>
			)
		}
		{
			lien && (
				<a href={lien.url} class="lien">
					{lien.libelle} <span aria-hidden="true">→</span>
				</a>
			)
		}
	</div>
	{vedette && illustration === 'pipeline' && <PipelineCI />}
	{
		captures.length > 0 && (
			<div class="captures">
				{captures.map(({ src, alt, legende }, i) => (
					// AVIF puis WebP, deux largeurs ; width et height dans le HTML
					// (aucun décalage). Sous le premier écran : chargement différé.
					<figure>
						<Picture
							src={src}
							alt={alt}
							formats={['avif', 'webp']}
							widths={[520, 1040]}
							sizes="(min-width: 900px) 520px, 100vw"
							loading="lazy"
							decoding="async"
						/>
						<figcaption>
							{legende} <a href={enGrand[i].src}>Voir en grand</a>
						</figcaption>
					</figure>
				))}
			</div>
		)
	}
</article>

<style>
	.projet {
		background: var(--surface);
		border: 1px solid var(--trait);
		border-radius: 24px;
		padding: 40px;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.texte {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.vedette {
		padding: 48px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
		gap: 48px;
	}

	.vedette .texte {
		gap: 18px;
	}

	.statuts {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
		font-family: var(--font-mono);
		font-size: 13px;
	}

	.statuts li {
		padding: 5px 11px;
		border-radius: 99px;
	}

	.sombre {
		background: var(--sombre);
		color: var(--fond);
	}

	.gris {
		background: var(--surface-grise);
		color: var(--texte-second);
	}

	/* Brun foncé sur ambre pâle : 7,5:1. */
	.ambre {
		background: #fdf0d5;
		color: #7a4b00;
	}

	h2 {
		font-size: 32px;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.vedette h2 {
		font-size: clamp(32px, 4vw, 46px);
		line-height: 1.05;
	}

	.corps {
		display: flex;
		flex-direction: column;
		gap: 18px;
		color: var(--texte-second);
	}

	/* Projet vedette : premier paragraphe en chapeau. */
	.vedette .corps :global(p:first-child) {
		font-size: 19px;
	}

	.image {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	/* Dimensions déclarées dans le HTML : la place est réservée avant le
	   chargement. Le CSS ne fait que l'adapter à la largeur de la fiche. */
	.image img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--trait);
		border-radius: 12px;
		background: #ffffff;
	}

	.image figcaption {
		font-size: 15px;
	}

	/* Captures : sous le texte et le pipeline, sur toute la largeur de la
	   fiche, côte à côte sur écran large. */
	.captures {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
		gap: 24px;
	}

	.captures figure {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.captures :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--trait);
		border-radius: 12px;
	}

	.captures figcaption {
		font-size: 15px;
		color: var(--texte-second);
	}

	.lien {
		align-self: flex-start;
		padding-block: 12px;
		font-weight: 600;
	}

	@media (max-width: 600px) {
		.projet,
		.vedette {
			padding: 24px;
		}

		.vedette {
			gap: 32px;
		}
	}
</style>

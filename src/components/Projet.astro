---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
	projet: CollectionEntry<'projets'>;
}

const { projet } = Astro.props;
const { titre, angle, mission, statut, lien } = projet.data;
const { Content } = await render(projet);

// Libellés repris tels quels du contenu rédigé.
const statuts = {
	'en-cours': 'Projet en cours.',
	conception: 'Phase de conception.',
};
---

<article class="projet" aria-labelledby={`projet-${projet.id}`}>
	<h3 id={`projet-${projet.id}`}>{titre} — {angle}</h3>
	<p class="mission">En lien avec&nbsp;: {mission}</p>
	<Content />
	{statut && <p class="statut"><em>{statuts[statut]}</em></p>}
	{lien && <p><a href={lien.url}>{lien.libelle}</a></p>}
</article>

<style>
	.projet {
		padding-top: 1.5rem;
		border-top: 1px solid var(--trait);
	}

	.projet + .projet {
		margin-top: 2.5rem;
	}

	.mission {
		margin-top: 0.4rem;
		color: var(--accent);
		font-weight: 600;
		font-size: 0.9375rem;
	}

	.statut {
		color: var(--texte-discret);
	}
</style>

---
// Un temps du pipeline : numéro, titre, puis le contenu passé en slot.
interface Props {
	numero: string;
	titre: string;
	id: string;
}

const { numero, titre, id } = Astro.props;
---

<section class="etape" id={id} aria-labelledby={`${id}-titre`}>
	<h2 id={`${id}-titre`}>
		<span class="numero">{numero}</span>
		<span class="sep" aria-hidden="true">·</span>
		{titre}
	</h2>
	<slot />
</section>

<style>
	.etape {
		/* Position verticale du jalon, partagée par le jalon et le trait. */
		--jalon-haut: 0.45em;
		--jalon-taille: 12px;

		position: relative;
		padding: 0 0 6rem 2rem;
	}

	/* Trait du pipeline. */
	.etape::after {
		content: '';
		position: absolute;
		left: -1px;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--trait);
	}

	/* Dernière étape : le trait s'arrête au jalon, il ne continue pas dans le vide. */
	.etape:last-of-type::after {
		bottom: auto;
		height: calc(var(--jalon-haut) + var(--jalon-taille) / 2);
	}

	/* Jalon, dessiné par-dessus le trait. */
	.etape::before {
		content: '';
		position: absolute;
		z-index: 1;
		left: calc(var(--jalon-taille) / -2);
		top: var(--jalon-haut);
		width: var(--jalon-taille);
		height: var(--jalon-taille);
		background: var(--fond);
		border: 2px solid var(--accent);
	}

	h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		margin-bottom: 1.5rem;
	}

	.numero {
		color: var(--accent);
		font-variant-numeric: tabular-nums;
	}

	.sep {
		color: var(--texte-discret);
		margin-inline: 0.2em;
	}
</style>

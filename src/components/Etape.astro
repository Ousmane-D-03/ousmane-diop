---
// Un temps du pipeline : numéro, titre, puis le contenu passé en slot.
interface Props {
	numero: string;
	titre: string;
	id: string;
}

const { numero, titre, id } = Astro.props;
---

<section class="etape" id={id} aria-labelledby={`${id}-titre`}>
	<h2 id={`${id}-titre`}>
		<span class="numero">{numero}</span>
		<span class="sep" aria-hidden="true">·</span>
		{titre}
	</h2>
	<slot />
</section>

<style>
	.etape {
		position: relative;
		padding: 0 0 6rem 2rem;
		border-left: 2px solid var(--trait);
	}

	/* Jalon sur le trait du pipeline. */
	.etape::before {
		content: '';
		position: absolute;
		left: -7px;
		top: 0.45em;
		width: 12px;
		height: 12px;
		background: var(--fond);
		border: 2px solid var(--accent);
	}

	h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
	}

	.numero {
		color: var(--accent);
		font-variant-numeric: tabular-nums;
	}

	.sep {
		color: var(--texte-discret);
		margin-inline: 0.2em;
	}
</style>

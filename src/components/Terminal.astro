---
// Fenêtre de terminal de l'accueil : qui je suis, ma stack, le déploiement.
// La dernière commande est « git push » : le site se déploie sur Cloudflare
// Workers à chaque push, quelle que soit la commande exécutée côté Cloudflare.
const stack = [
	['backend', 'FastAPI · PostgreSQL · Redis'],
	['ci/cd', 'GitHub Actions · Docker'],
	['sécurité', 'Gitleaks · Bandit · Trivy'],
	['cloud', 'AWS Lambda · DynamoDB · SAM'],
	['web', 'HTML · CSS · JS/TS · React · Vue'],
];

// Animation d'ouverture, en CSS seulement. Tout le texte est dans le HTML dès
// le départ et occupe déjà sa place : l'animation ne fait que le dévoiler
// (clip-path pour la frappe, opacity pour les sorties), la hauteur ne change
// pas. Instants de départ, en secondes ; frappe : 70 ms par caractère.
const frappe = (commande: string, debut: number) =>
	`--n:${commande.length};--debut:${debut}s`;
const a = (debut: number) => `--debut:${debut}s`;
---

<div class="terminal">
	<div class="barre">
		<span class="pastille" aria-hidden="true"></span>
		<span class="pastille" aria-hidden="true"></span>
		<span class="pastille" aria-hidden="true"></span>
		<span class="titre">~/portfolio — zsh</span>
	</div>
	<div class="ecran">
		<p>
			<span class="invite">~/portfolio $</span>{' '}
			<span class="frappe" style={frappe('whoami', 0.4)}>whoami</span>
		</p>
		<p class="sortie espace apparait" style={a(1.1)}>Ousmane Sarr Diop — M1 Informatique, UT3</p>
		<p class="apparait" style={a(1.5)}>
			<span class="invite">~/portfolio $</span>{' '}
			<span class="frappe" style={frappe('cat stack.txt', 1.5)}>cat stack.txt</span>
		</p>
		<dl class="sortie espace apparait" style={a(2.7)}>
			{
				stack.map(([domaine, outils]) => (
					<>
						<dt>{domaine}</dt>
						<dd>{outils}</dd>
					</>
				))
			}
		</dl>
		<p class="apparait" style={a(3.1)}>
			<span class="invite">~/portfolio $</span>{' '}
			<span class="frappe" style={frappe('git push', 3.1)}>git push</span>
		</p>
		<p class="ok apparait" style={a(4.3)}>✓ Déployé sur ousmane-diop.ousmanesarrd.workers.dev</p>
		<p class="apparait" style={a(4.6)}>
			<span class="invite">~/portfolio $</span>{' '}
			<span class="curseur" aria-hidden="true"></span>
		</p>
	</div>
</div>

<style>
	.terminal {
		background: var(--sombre);
		border-radius: 20px;
		padding-bottom: 28px;
		box-shadow: 0 30px 60px -30px rgba(14, 17, 22, 0.55);
		overflow: hidden;
		font-family: var(--font-mono);
		font-size: 14.5px;
		line-height: 1.75;
		color: var(--sur-sombre);
	}

	.barre {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 14px 18px;
		border-bottom: 1px solid var(--trait-sombre);
	}

	.pastille {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: #3a404a;
	}

	.titre {
		margin-left: 10px;
		color: var(--sur-sombre-discret);
		font-size: 13px;
	}

	.ecran {
		padding: 22px 26px 0;
		/* L'adresse du site est un seul long mot : coupée plutôt que de
		   déborder sur écran étroit. */
		overflow-wrap: anywhere;
	}

	.invite {
		color: var(--terminal-invite);
	}

	.sortie {
		color: var(--sur-sombre-second);
	}

	.espace {
		margin-bottom: 12px;
	}

	dl {
		margin-top: 0;
		display: grid;
		grid-template-columns: 110px 1fr;
		column-gap: 12px;
	}

	dt {
		color: var(--sur-sombre-lien);
	}

	dd {
		margin: 0;
	}

	.ok {
		color: var(--terminal-ok);
	}

	.curseur {
		display: inline-block;
		width: 9px;
		height: 17px;
		background: var(--sur-sombre);
		vertical-align: -3px;
	}

	/* La commande occupe exactement sa largeur : n caractères de chasse fixe. */
	.frappe {
		display: inline-block;
	}

	/* Animation d'ouverture. Déclarée seulement sans préférence de mouvement
	   réduit : sinon (ou si le navigateur ignore ces règles) le terminal est
	   affiché complet, immobile. « backwards » : avant son instant de départ,
	   chaque élément est dans l'état de début (masqué) ; ensuite il revient à
	   son état normal, visible. Aucun JavaScript. */
	@media (prefers-reduced-motion: no-preference) {
		/* Frappe : la commande se dévoile caractère par caractère. */
		.frappe {
			animation: frappe calc(var(--n) * 70ms) steps(var(--n)) var(--debut) backwards;
		}

		/* Sorties et nouvelles invites : apparition d'un coup. L'opacité
		   garde le texte dans l'arbre d'accessibilité et à sa place. */
		.apparait {
			animation: apparait 1ms var(--debut) backwards;
		}

		/* Curseur : clignote cinq fois puis reste fixe (WCAG 2.2.2 : rien ne
		   clignote plus de cinq secondes). */
		.curseur {
			animation: clignote 1s steps(1) 4.6s 5;
		}
	}

	@keyframes frappe {
		from {
			clip-path: inset(0 100% 0 0);
		}
		to {
			clip-path: inset(0);
		}
	}

	@keyframes apparait {
		from {
			opacity: 0;
		}
	}

	@keyframes clignote {
		50% {
			opacity: 0;
		}
	}

	@media (max-width: 600px) {
		.ecran {
			padding-inline: 18px;
		}

		dl {
			grid-template-columns: 80px 1fr;
		}
	}
</style>

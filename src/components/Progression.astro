---
// Indicateur d'avancement, collé en haut de l'écran.
// - La barre suit le défilement en CSS pur (animation-timeline) : aucun JS.
// - Le script ne fait qu'une chose : marquer l'étape en cours (aria-current).
// Sans JS, la navigation par ancres et la barre fonctionnent toujours.
interface Props {
	etapes: { numero: string; titre: string; id: string }[];
}

const { etapes } = Astro.props;
---

<nav class="progression" aria-label="Étapes">
	<ol>
		{
			etapes.map((e) => (
				<li>
					<a href={`#${e.id}`}>
						<span class="numero">{e.numero}</span>
						<span class="titre"> {e.titre}</span>
					</a>
				</li>
			))
		}
	</ol>
	<div class="barre" aria-hidden="true"></div>
</nav>

<script>
	const liens = [...document.querySelectorAll<HTMLAnchorElement>('.progression a')];
	const sections = liens.map((a) => document.querySelector<HTMLElement>(a.hash));

	let enAttente = false;

	function marquerEtapeActive() {
		enAttente = false;
		const seuil = innerHeight * 0.4;
		let actif = -1;
		sections.forEach((s, i) => {
			if (s && s.getBoundingClientRect().top <= seuil) actif = i;
		});
		// Tout en bas de page, la dernière étape est active même si elle est courte.
		if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) {
			actif = sections.length - 1;
		}
		liens.forEach((a, i) => {
			if (i === actif) a.setAttribute('aria-current', 'location');
			else a.removeAttribute('aria-current');
		});
	}

	// Au plus un calcul par image affichée, quel que soit le nombre d'événements.
	addEventListener(
		'scroll',
		() => {
			if (!enAttente) {
				enAttente = true;
				requestAnimationFrame(marquerEtapeActive);
			}
		},
		{ passive: true },
	);
	addEventListener('resize', marquerEtapeActive);
	marquerEtapeActive();
</script>

<style>
	.progression {
		position: sticky;
		top: 0;
		z-index: 1;
		background: var(--fond);
		border-bottom: 1px solid var(--trait);
	}

	ol {
		list-style: none;
		margin: 0 auto;
		max-width: var(--mesure);
		padding: 0.75rem var(--marge);
		display: flex;
		gap: 1.5rem;
	}

	/* Taille réduite sur les liens et non sur la liste : --mesure est en `ch`,
	   une police plus petite sur <ol> rétrécirait la colonne et la décalerait. */
	a {
		font-size: 0.9375rem;
		color: var(--texte-discret);
		text-decoration: none;
		white-space: nowrap;
	}

	a:hover,
	a[aria-current] {
		color: var(--texte);
	}

	.numero {
		font-family: var(--font-titres);
		font-variant-numeric: tabular-nums;
	}

	a[aria-current] .numero {
		color: var(--accent);
		font-weight: 700;
	}

	/* Écran étroit : les numéros seuls tiennent sur une ligne.
	   Les titres restent lus par les lecteurs d'écran. */
	@media (max-width: 34rem) {
		ol {
			gap: 2rem;
		}

		.titre {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
	}

	/* La seule animation du site. Absente si le navigateur ne sait pas la lier
	   au défilement, ou si le visiteur a demandé à réduire les animations. */
	.barre {
		display: none;
	}

	@supports (animation-timeline: scroll()) {
		@media (prefers-reduced-motion: no-preference) {
			.barre {
				display: block;
				position: absolute;
				left: 0;
				right: 0;
				bottom: -1px;
				height: 2px;
				background: var(--accent);
				transform-origin: 0 50%;
				/* Propriétés détaillées, pas le raccourci `animation` : au build, le
				   minifieur fusionnait tout en `animation: … scroll(root)`, forme que
				   le navigateur rejette (la barre restait pleine en permanence). */
				animation-name: avancement;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: scroll(root);
			}
		}
	}

	@keyframes avancement {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}
</style>

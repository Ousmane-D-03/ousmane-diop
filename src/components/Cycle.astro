---
// Illustration d'ouverture de la page de contenu : la boucle du cycle DevOps,
// en grand, avec ses huit étapes nommées.
// C'est l'illustration du métier, PAS le plan de la page : aucune étape n'est
// associée aux sections 01–04. D'où une typographie distincte (minuscules,
// Inter, gris, sans numéro) et un grand espace avant la navigation.
// Le tracé se dessine une fois à l'arrivée ; les libellés sont visibles
// d'emblée (rien ne retarde le premier affichage).

// Repère 100 × 46 ; seule la bande y = 5 à 41 est affichée (viewBox). Départ au croisement central, lobe gauche d'abord
// (plan → code → build → test), puis lobe droit (release → deploy →
// operate → monitor) : l'ordre canonique du cycle.
const boucle =
	'M50,23 C44,13 16,10 16,23 C16,36 44,33 50,23 C56,13 84,10 84,23 C84,36 56,33 50,23';

// Position de chaque libellé dans le repère du dessin (x de 0 à 100, y de 5 à 41,
// la bande affichée) et son
// ancrage : au centre, ou collé à gauche / à droite de sa position.
const etapes = [
	{ nom: 'plan', x: 28, y: 9.5, ancre: 'centre' },
	{ nom: 'code', x: 13, y: 23, ancre: 'droite' },
	{ nom: 'build', x: 28, y: 36.5, ancre: 'centre' },
	{ nom: 'test', x: 43.5, y: 34, ancre: 'centre' },
	{ nom: 'release', x: 56.5, y: 12, ancre: 'centre' },
	{ nom: 'deploy', x: 72, y: 9.5, ancre: 'centre' },
	{ nom: 'operate', x: 87, y: 23, ancre: 'gauche' },
	{ nom: 'monitor', x: 72, y: 36.5, ancre: 'centre' },
];
---

<figure class="cycle" aria-labelledby="cycle-legende">
	<div class="schema">
		<svg viewBox="0 5 100 36" aria-hidden="true" focusable="false">
			<path d={boucle} pathLength="100" />
		</svg>
		<ol class="etapes">
			{
				etapes.map((e) => (
					<li class={e.ancre} style={`--x: ${e.x}; --y: ${e.y}`}>
						{e.nom}
					</li>
				))
			}
		</ol>
	</div>
	<figcaption id="cycle-legende">Le cycle DevOps</figcaption>
</figure>

<style>
	.cycle {
		max-width: var(--largeur-page);
		margin: 0 auto;
		/* Grand espace en bas : l'illustration ne doit pas sembler introduire
		   directement la section 01. */
		padding: 1rem var(--marge) clamp(4rem, 9vw, 7rem);
	}

	.schema {
		position: relative;
		max-width: 46rem;
		margin-inline: auto;
	}

	svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}

	path {
		fill: none;
		stroke: var(--accent);
		stroke-width: 0.55;
		stroke-linejoin: round;
		stroke-dasharray: 100;
		stroke-dashoffset: 0;
	}

	/* Libellés : ni numéros, ni vert, ni police des titres, pour ne pas se
	   confondre avec les sections 01–04. */
	.etapes {
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: clamp(0.875rem, 1.6vw, 1rem);
		font-weight: 500;
		color: var(--texte-discret);
	}

	.etapes li {
		position: absolute;
		left: calc(var(--x) * 1%);
		top: calc((var(--y) - 5) / 36 * 100%);
		transform: translate(-50%, -50%);
		white-space: nowrap;
		line-height: 1;
	}

	.etapes .droite {
		transform: translate(-100%, -50%);
	}

	.etapes .gauche {
		transform: translate(0, -50%);
	}

	figcaption {
		margin-top: 1.25rem;
		text-align: center;
		font-size: 0.875rem;
		color: var(--texte-discret);
	}

	/* Écran étroit : autour de la boucle, les libellés se chevaucheraient.
	   Ils passent sous la boucle, en deux colonnes, chacune sous son lobe
	   (gauche : plan → test ; droite : release → monitor). */
	@media (max-width: 34rem) {
		/* Boucle plus petite : trait un peu plus épais pour rester net. */
		path {
			stroke-width: 0.8;
		}

		.etapes {
			display: grid;
			grid-template-columns: 1fr 1fr;
			grid-template-rows: repeat(4, auto);
			grid-auto-flow: column;
			gap: 0.4rem 1rem;
			margin-top: 1rem;
			text-align: center;
		}

		.etapes li,
		.etapes .droite,
		.etapes .gauche {
			position: static;
			transform: none;
		}
	}

	/* Le tracé se dessine une seule fois à l'arrivée, puis ne bouge plus.
	   En mouvement réduit : dessiné d'emblée. */
	@media (prefers-reduced-motion: no-preference) {
		path {
			animation-name: dessin;
			animation-duration: 1.8s;
			animation-delay: 0.3s;
			animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
			animation-fill-mode: both;
		}
	}

	@keyframes dessin {
		from {
			stroke-dashoffset: 100;
		}
		to {
			stroke-dashoffset: 0;
		}
	}
</style>

---
import Base from '../layouts/Base.astro';
import EnTete from '../components/EnTete.astro';
import Bouton from '../components/Bouton.astro';

// Les trois axes de l'offre. Chaque axe : la mission telle que décrite dans
// l'offre, ce que j'y apporte déjà, ce que je viens y apprendre.
const axes = [
	{
		id: 'axe-web',
		numero: 'Axe 1',
		titre: 'Concevoir, développer et faire évoluer des sites',
		mission: [
			'Recueillir et reformuler le besoin d’un client',
			'Définir périmètre, contenus et parcours utilisateurs',
			'Développer pages, composants et formulaires avec Astro',
			'Maintenir, corriger, optimiser performance, accessibilité et SEO',
		],
		apport: [
			'Un CMS complet en Laravel/PHP livré pour une entreprise de conseil',
			'HTML, CSS, JavaScript/TypeScript, React, Vue, Vite',
			'Des API REST conçues et consommées (FastAPI, Spring Boot)',
			'Modélisation UML et cadrage fonctionnel (SunuDossier)',
		],
		apprendre: [
			'Astro et son modèle par composants et îlots',
			'SEO technique et accessibilité en conditions réelles',
			'Reformuler un besoin face à un vrai client',
		],
	},
	{
		id: 'axe-deploiement',
		numero: 'Axe 2',
		titre: 'Déployer, exploiter, automatiser',
		mission: [
			'Préparer et réaliser les déploiements',
			'Gérer domaines, DNS et certificats, notamment sur Cloudflare',
			'Mettre en place CI/CD et automatisations simples',
			'Lire des logs, diagnostiquer un incident, vérifier les sauvegardes',
		],
		apport: [
			'Un pipeline GitHub Actions : lint, tests, build, publication Docker Hub',
			'Des scans de sécurité intégrés : Gitleaks, Bandit, Trivy',
			'Du serverless AWS en Infrastructure as Code, suivi dans CloudWatch',
			'Des scripts d’automatisation Linux en remplacement de tâches manuelles',
		],
		apprendre: [
			'Cloudflare au-delà de Workers : DNS, certificats, règles',
			'Le diagnostic d’incidents sur des sites en production',
			'Documenter une procédure de reprise',
		],
	},
	{
		id: 'axe-gouvernance',
		numero: 'Axe 3',
		titre: 'Gouvernance numérique et organisation IT',
		part: '≈ 25 % du temps',
		mission: [
			'Recenser applications, services, utilisateurs et prestataires',
			'Cartographier les données et les dépendances',
			'Examiner comptes, droits d’accès et authentification',
			'Formaliser arrivées, départs, sauvegardes, incidents',
		],
		apport: [
			'Une formation sécurité (M1 ARIAS, Université d’Orléans)',
			'Une conception orientée sécurité : rôles, journalisation des accès',
			'De l’authentification JWT en pratique (Xëy Invest)',
			'L’habitude de documenter et de transmettre (tutorat, encadrement)',
		],
		apprendre: [
			'Mener un état des lieux dans une organisation',
			'Le RGPD appliqué au quotidien',
			'Transformer un inventaire en actions priorisées',
		],
	},
];

const questions = [
	'Comment gérez-vous le contenu de vos sites Astro : Markdown dans le dépôt, CMS headless, autre chose ?',
	'À quoi ressemble votre flux de mise en production : preview par branche, validation client, puis merge ?',
	'Pour la cartographie IT d’un client, partez-vous d’un modèle d’inventaire commun ?',
];
---

<Base
	titre="Le stage — ce que j’ai compris · Ousmane Sarr Diop"
	description="Ma lecture de l’offre de stage d’Alpha to Omega : développement web, déploiement et exploitation, gouvernance numérique."
>
	<EnTete />

	<main>
		<section class="conteneur intro">
			<p class="surtitre">Ma lecture de l’offre</p>
			<h1>Ce que j’ai compris du stage.</h1>
			<p class="chapeau">
				Alpha to Omega pilote des projets numériques de bout en bout, sur deux expertises : le web et
				l’intelligence artificielle. Le stage suit la même logique — le web en est le cœur, avec une
				ouverture vers l’exploitation technique et la gouvernance numérique.
			</p>
		</section>

		<nav aria-label="Répartition du stage" class="conteneur repartition">
			<div class="barre">
				<a href="#axe-web" class="part web">
					<span class="part-numero">Axe 1 · le cœur du stage</span>
					<span class="part-titre">Conception &amp; développement web</span>
				</a>
				<a href="#axe-deploiement" class="part deploiement">
					<span class="part-numero">Axe 2</span>
					<span class="part-titre">Déploiement &amp; exploitation</span>
				</a>
				<a href="#axe-gouvernance" class="part gouvernance">
					<span class="part-numero">Axe 3 · ≈ 25 %</span>
					<span class="part-titre">Gouvernance numérique</span>
				</a>
			</div>
		</nav>

		<section class="axes" aria-label="Les trois axes du stage">
			<div class="conteneur axes-interieur">
				{
					axes.map((axe) => (
						<article id={axe.id} class="axe">
							<div class="axe-tete">
								<span class="axe-numero">{axe.numero}</span>
								<h2>{axe.titre}</h2>
								{axe.part && <span class="axe-part">{axe.part}</span>}
							</div>
							<div class="colonnes">
								<div class="col mission">
									<h3 class="etiquette">La mission</h3>
									<ul>{axe.mission.map((point) => <li>{point}</li>)}</ul>
								</div>
								<div class="col apport">
									<h3 class="etiquette">Ce que j’apporte</h3>
									<ul>{axe.apport.map((point) => <li>{point}</li>)}</ul>
								</div>
								<div class="col apprendre">
									<h3 class="etiquette">Ce que je vais apprendre</h3>
									<ul>{axe.apprendre.map((point) => <li>{point}</li>)}</ul>
								</div>
							</div>
						</article>
					))
				}

				<div class="lectures">
					<div class="lecture cadre">
						<h2 class="etiquette">Ma lecture du cadre</h2>
						<p>
							Sur la gouvernance, mon rôle serait de poser les bonnes questions, structurer
							l’existant et préparer des décisions — pas de rendre seul un avis juridique.
						</p>
					</div>
					<div class="lecture">
						<h2 class="etiquette">L’IA comme outil de travail</h2>
						<p>
							Explorer une doc, comprendre une base de code, préparer des tests — oui. Mais toujours
							vérifier ce qui sort, et reprendre à la main quand il le faut.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="conteneur questions">
			<div class="questions-tete">
				<p class="surtitre">Curiosité</p>
				<h2 class="titre-questions">Les questions que j’aimerais vous poser</h2>
			</div>
			<ol>
				{
					questions.map((question, i) => (
						<li>
							<span class="q">Q{i + 1}</span>
							{question}
						</li>
					))
				}
			</ol>
			<div class="suite">
				<Bouton href="/projets/" fleche>Voir les projets qui le prouvent</Bouton>
			</div>
		</section>
	</main>
</Base>

<style>
	/* ---- Introduction ---- */
	.intro {
		padding-block: 64px 56px;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	h1 {
		max-width: 900px;
	}

	.chapeau {
		font-size: 20px;
		color: var(--texte-second);
		max-width: 760px;
	}

	/* ---- Barre de répartition ---- */
	.repartition {
		padding-bottom: 96px;
	}

	.barre {
		display: flex;
		flex-wrap: wrap;
		border-radius: 18px;
		overflow: hidden;
		min-height: 132px;
	}

	.part {
		padding: 24px 28px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 12px;
		text-decoration: none;
	}

	.part-numero {
		font-family: var(--font-mono);
		font-size: 13px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.part-titre {
		font-family: var(--font-titres);
		font-size: 22px;
		font-weight: 700;
		line-height: 1.2;
	}

	/* Largeurs proportionnelles au poids de chaque axe dans le stage. */
	.web,
	.web:hover {
		flex: 5 1 300px;
		background: var(--accent);
		color: #ffffff;
	}

	.web .part-titre {
		font-size: 24px;
	}

	.deploiement,
	.deploiement:hover {
		flex: 2.5 1 220px;
		background: var(--accent-moyen);
		color: var(--texte);
	}

	.gouvernance,
	.gouvernance:hover {
		flex: 2.5 1 220px;
		background: var(--accent-pale);
		color: var(--texte);
	}

	/* ---- Les trois axes ---- */
	.axes {
		background: var(--surface);
		border-top: 1px solid var(--trait);
	}

	.axes-interieur {
		padding-block: 24px 96px;
		display: flex;
		flex-direction: column;
	}

	.axe {
		padding-block: 64px;
		border-bottom: 1px solid var(--trait);
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	.axe-tete {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 16px 24px;
	}

	.axe-numero {
		font-family: var(--font-mono);
		font-size: 15px;
		color: var(--accent);
		font-weight: 600;
	}

	.axe-tete h2 {
		font-size: clamp(28px, 3.4vw, 40px);
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.axe-part {
		font-family: var(--font-mono);
		font-size: 13px;
		padding: 6px 12px;
		border-radius: 99px;
		background: var(--accent-pale);
		color: var(--accent-sombre);
	}

	.colonnes {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
		gap: 16px;
	}

	.col {
		padding: 28px;
		border-radius: 16px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.col h3 {
		font-weight: 400;
		line-height: 1.6;
	}

	.mission {
		background: var(--fond);
	}

	.apport {
		background: var(--sombre);
		color: var(--sur-sombre);
	}

	.apport h3 {
		color: var(--sur-sombre-discret);
	}

	.apprendre {
		border: 1.5px dashed var(--sur-sombre-discret);
	}

	.col ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.col li {
		padding-left: 22px;
		position: relative;
		line-height: 1.5;
	}

	/* Tiret court devant chaque point, dans la couleur du texte. */
	.col li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.62em;
		width: 10px;
		height: 2px;
		background: currentColor;
		opacity: 0.55;
	}

	/* ---- Les deux lectures ---- */
	.lectures {
		padding-top: 64px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
		gap: 20px;
	}

	.lecture {
		padding: 36px;
		border-radius: 18px;
		background: var(--fond);
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.lecture h2 {
		font-weight: 400;
	}

	.cadre {
		background: var(--accent-pale);
	}

	.cadre h2 {
		color: var(--accent-sombre);
	}

	.lecture p {
		font-family: var(--font-titres);
		font-size: 24px;
		font-weight: 500;
		line-height: 1.35;
	}

	/* ---- Questions ---- */
	.questions {
		padding-block: 112px;
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	.questions-tete {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.titre-questions {
		font-size: clamp(30px, 4vw, 46px);
		line-height: 1.08;
		letter-spacing: -0.02em;
	}

	ol {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		border-top: 1.5px solid var(--texte);
	}

	ol li {
		display: grid;
		grid-template-columns: 64px 1fr;
		gap: 16px;
		padding-block: 28px;
		border-bottom: 1px solid var(--trait-fort);
		font-size: 21px;
		line-height: 1.45;
	}

	.q {
		font-family: var(--font-mono);
		font-size: 15px;
		color: var(--texte-discret);
		padding-top: 4px;
	}

	.suite {
		padding-top: 16px;
	}

	@media (max-width: 600px) {
		.repartition {
			padding-bottom: 64px;
		}

		.axe {
			padding-block: 48px;
		}

		.col,
		.lecture {
			padding: 24px;
		}

		.lecture p {
			font-size: 21px;
		}

		.questions {
			padding-block: 72px;
		}

		ol li {
			grid-template-columns: 40px 1fr;
			font-size: 19px;
		}
	}
</style>

---
import Base from '../layouts/Base.astro';
import Derive from '../components/Derive.astro';
---

<Base
	titre="Ousmane Sarr Diop — candidature Alpha to Omega"
	description="Candidature de stage d’Ousmane Sarr Diop chez Alpha to Omega."
>
	<main class="accueil">
		<Derive />
		<div class="colonne centre">
			<h1>Ousmane Sarr Diop</h1>
			<p class="accroche">
				Je viens du backend et de l’infrastructure. Je veux apprendre le web du côté de la production.
			</p>
		</div>
		<p class="colonne bas">
			<a href="/candidature/" class="decouvrir">Découvrir</a>
		</p>
	</main>
</Base>

<style>
	/* Un écran plein. svh : la hauteur visible quand la barre d’adresse
	   mobile est déployée, pour que le lien du bas ne passe pas dessous. */
	.accueil {
		position: relative;
		min-height: 100svh;
		display: grid;
		grid-template-rows: 1fr auto;
	}

	/* Bloc centré dans l’écran, texte aligné à gauche. */
	.colonne {
		width: min(56rem, 100% - 2 * var(--marge));
		margin-inline: auto;
	}

	.centre {
		align-self: center;
	}

	/* Le texte passe devant le fond qui dérive. */
	.centre,
	.bas {
		position: relative;
	}

	h1 {
		font-size: clamp(2.8rem, 8vw, 5.5rem);
		line-height: 1.02;
	}

	.accroche {
		margin: 1.5rem 0 0;
		font-size: clamp(1.15rem, 2.2vw, 1.5rem);
		max-width: 38ch;
	}

	.bas {
		margin-block: 0 clamp(2rem, 6vh, 3.5rem);
	}

	.decouvrir {
		font-size: 1.125rem;
		font-weight: 600;
		text-underline-offset: 0.3em;
	}
</style>

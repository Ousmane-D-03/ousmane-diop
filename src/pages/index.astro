---
import Base from '../layouts/Base.astro';
import Derive from '../components/Derive.astro';
---

<Base
	titre="Ousmane Sarr Diop — candidature Alpha to Omega"
	description="Candidature de stage d’Ousmane Sarr Diop chez Alpha to Omega."
>
	<main class="accueil">
		<Derive />
		<div class="centre">
			<h1 class="nom">Ousmane Sarr Diop</h1>
			<p class="accroche">
				Je viens du backend et de l’infrastructure. Je veux apprendre le web du côté de la production.
			</p>
			<a href="/candidature/" class="decouvrir">Découvrir</a>
		</div>
	</main>
</Base>

<style>
	/* Un écran plein. svh : la hauteur visible quand la barre d’adresse
	   mobile est déployée. */
	.accueil {
		position: relative;
		min-height: 100svh;
		display: grid;
		align-items: center;
	}

	/* Bloc centré dans l’écran, texte aligné à gauche, devant le fond. */
	.centre {
		position: relative;
		width: min(56rem, 100% - 2 * var(--marge));
		margin-inline: auto;
		padding-block: 3rem;
	}

	h1 {
		font-size: clamp(2.8rem, 8vw, 5.5rem);
		/* Même interligne que sur /candidature/ : sinon les proportions du nom
		   diffèrent (12,7 % mesurés) et le glissement saute. */
		line-height: 1.05;
		/* Même nom sur /candidature/ : le nom glisse d’une page à l’autre. */
		view-transition-name: nom;
		/* Largeur du texte, pas de la colonne : même proportions sur les deux
		   pages, sinon les deux images de la transition se décalent. */
		width: fit-content;
	}

	.accroche {
		margin: 1.5rem 0 0;
		font-size: clamp(1.15rem, 2.2vw, 1.5rem);
		max-width: 38ch;
		view-transition-name: accroche;
		width: fit-content;
	}

	/* Bouton plein. Coins carrés comme les jalons et les traits du site.
	   Texte #f7f8f6 sur #0a5c36 : 7,59:1 ; au survol, vert plus sombre
	   #084a2c : 9,73:1. Pas de transition de couleur : changement net.
	   Focus clavier : contour global (2px accent, décalé de 3px). */
	.decouvrir {
		display: inline-block;
		margin-top: 2.5rem;
		padding: 0.85em 1.75em;
		background: var(--accent);
		color: var(--fond);
		font-size: 1.0625rem;
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
	}

	.decouvrir:hover {
		background: #084a2c;
	}

	/* Écran étroit : le nom se coupe après « Sarr » sur les deux pages.
	   Limite en em : elle suit la taille de police, donc même coupure et mêmes
	   proportions quelle que soit la taille, et le glissement reste propre. */
	@media (max-width: 32rem) {
		h1 {
			max-width: min(8em, 100%);
			/* « Ousmane Sarr » fait environ 8em : la taille suit la largeur
			   disponible pour que cette première ligne tienne toujours. */
			font-size: min(2.8rem, calc((100vw - 2 * var(--marge)) / 8.2));
		}
	}
</style>

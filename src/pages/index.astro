---
import Base from '../layouts/Base.astro';
import Etape from '../components/Etape.astro';
import Progression from '../components/Progression.astro';

const etapes = [
	{ numero: '01', titre: 'Qui je suis', id: 'qui-je-suis' },
	{ numero: '02', titre: 'Vos missions', id: 'vos-missions' },
	{ numero: '03', titre: 'Mes projets', id: 'mes-projets' },
	{ numero: '04', titre: 'Ma démarche', id: 'ma-demarche' },
];
---

<Base
	titre="Ousmane Sarr Diop — candidature Alpha to Omega"
	description="Candidature de stage d'Ousmane Sarr Diop chez Alpha to Omega."
>
	<header class="entete">
		<h1>Ousmane Sarr Diop</h1>
		<Progression etapes={etapes} />
	</header>

	<main class="pipeline">
		{etapes.map((e) => <Etape {...e} />)}
	</main>
</Base>

<style>
	.entete,
	.pipeline {
		max-width: var(--mesure);
		margin-inline: auto;
		padding-inline: var(--marge);
	}

	.entete {
		padding-block: 4rem 3rem;
		display: grid;
		gap: 1.5rem;
	}

	h1 {
		font-size: clamp(2.2rem, 5vw, 3.5rem);
	}
</style>

---
// Sans 404.html, Cloudflare Pages suppose une application monopage et sert
// l'accueil (code 200) pour toute adresse inconnue. Cette page produit
// dist/404.html : Pages la sert avec un vrai code 404.
import Base from '../layouts/Base.astro';
---

<Base
	titre="Page introuvable — Ousmane Sarr Diop"
	description="Cette adresse ne correspond à aucune page du site."
	indexable={false}
>
	<main class="introuvable">
		<div class="centre">
			<p class="code">404</p>
			<h1>Page introuvable</h1>
			<p>Cette adresse ne correspond à aucune page du site.</p>
			<a href="/" class="retour">Retour à l’accueil</a>
		</div>
	</main>
</Base>

<style>
	.introuvable {
		min-height: 100svh;
		display: grid;
		align-items: center;
	}

	.centre {
		width: min(40rem, 100% - 2 * var(--marge));
		margin-inline: auto;
	}

	.code {
		margin: 0 0 0.5rem;
		font-family: var(--font-titres);
		font-weight: 700;
		color: var(--accent);
		font-variant-numeric: tabular-nums;
	}

	h1 {
		font-size: clamp(2.2rem, 6vw, 3.5rem);
		margin-bottom: 1rem;
	}

	/* Même bouton que « Découvrir » sur l'accueil. */
	.retour {
		display: inline-block;
		margin-top: 1.5rem;
		padding: 0.85em 1.75em;
		background: var(--accent);
		color: var(--fond);
		font-size: 1.0625rem;
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
	}

	.retour:hover {
		background: #084a2c;
	}
</style>
